# Requis
MISTRAL_API_KEY=
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
WETOPIA_CRON_SECRET=          # secret du cron nocturne (sans lui, l endpoint reste fermé)

# Production — stockage durable des bundles (Cellar)
# Clever Cloud injecte CELLAR_ADDON_* si l'add-on Cellar est lié à l'app :
# il ne reste qu'à nommer le bucket.
# WETOPIA_BUNDLE_BUCKET=wetopia-bundles
# WETOPIA_BUNDLE_PREFIX=       # optionnel : plusieurs déploiements dans un bucket
# Sans ces variables, les bundles restent dans un répertoire local.
# Pour un autre fournisseur S3 (Scaleway, MinIO) :
# WETOPIA_S3_ENDPOINT= / WETOPIA_S3_KEY_ID= / WETOPIA_S3_KEY_SECRET= / WETOPIA_S3_REGION=

# Production
# DATABASE_URL=postgres://…   # auth uniquement ; sans lui, SQLite local
# WETOPIA_RUNTIME=/app/runtime
# WETOPIA_MODEL=mistral-medium-latest   # alias volontaire : les snapshots datés
                                        # sont retirés, pas l'alias (cf. OPERATIONS.md)
# WETOPIA_TRANSCRIPTION_MODEL=voxtral-mini-latest
# WETOPIA_KEEP_BUNDLES=30
# WETOPIA_SESSION_RETENTION_DAYS=90   # transcripts supprimés au-delà ; 0 = conserver indéfiniment
# WETOPIA_LINT_MAX_AGE_H=36   # au-delà, /api/health signale que le cron ne tourne plus
